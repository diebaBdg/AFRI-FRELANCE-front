{
  "name": "FreelancerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string",
      "description": "Denormalized display name of the owner user"
    },
    "headline": {
      "type": "string",
      "description": "Professional title / tagline"
    },
    "bio": {
      "type": "string",
      "description": "Detailed biography"
    },
    "category": {
      "type": "string",
      "description": "Primary category id (matches Project categories)"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced",
              "expert"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "description": "Skills with proficiency level"
    },
    "hourly_rate": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number"
    },
    "min_project_rate": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "XOF",
        "GBP"
      ],
      "default": "USD"
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "available_now",
        "available_soon",
        "unavailable"
      ],
      "default": "available_now"
    },
    "availability_commitment": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "per_project"
      ],
      "default": "per_project"
    },
    "hours_per_week": {
      "type": "number"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "elementary",
              "intermediate",
              "advanced",
              "fluent",
              "native"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "current": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "school": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "school"
        ]
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string"
          },
          "credential_id": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "linkedin": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "behance": {
          "type": "string"
        },
        "dribbble": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "other": {
          "type": "string"
        }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "work_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "email": {
          "type": "boolean"
        },
        "phone": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "professional": {
          "type": "boolean"
        }
      }
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "top_freelancer": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "avatar_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "reviews": {
      "type": "number",
      "default": 0
    },
    "experience_years": {
      "type": "number"
    },
    "response_time": {
      "type": "string"
    }
  },
  "required": [
    "headline"
  ]
}
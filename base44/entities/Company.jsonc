{
  "properties": {
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": [
        "solo",
        "small",
        "medium",
        "large",
        "enterprise"
      ]
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "recruiter",
              "member"
            ]
          }
        },
        "required": [
          "name",
          "role"
        ]
      }
    }
  },
  "required": [
    "name"
  ],
  "name": "Company",
  "type": "object"
}
{
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Project the proposal targets"
    },
    "project_title": {
      "type": "string"
    },
    "freelancer_name": {
      "type": "string",
      "description": "Denormalized name of the submitting freelancer"
    },
    "price": {
      "type": "number",
      "description": "Proposed price in the project currency"
    },
    "delay_days": {
      "type": "number",
      "description": "Estimated delivery delay in days"
    },
    "message": {
      "type": "string",
      "description": "Cover letter / pitch"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "withdrawn"
      ],
      "default": "pending"
    }
  },
  "required": [
    "project_id",
    "freelancer_name"
  ],
  "name": "Proposal",
  "type": "object"
}
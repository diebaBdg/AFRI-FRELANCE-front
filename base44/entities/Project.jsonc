{
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_min": {
      "type": "number"
    },
    "budget_max": {
      "type": "number"
    },
    "budget_type": {
      "type": "string",
      "enum": [
        "fixed",
        "monthly"
      ],
      "default": "fixed"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "published"
    },
    "client_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "objectives": {
      "type": "string"
    },
    "deliverables": {
      "type": "string"
    },
    "contract_type": {
      "type": "string"
    },
    "experience_level": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "name": "Project",
  "type": "object"
}
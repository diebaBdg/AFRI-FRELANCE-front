{
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Individual or company display name"
    },
    "kind": {
      "type": "string",
      "enum": [
        "individual",
        "company"
      ],
      "default": "individual"
    },
    "description": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "company_id": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "display_name"
  ],
  "name": "ClientProfile",
  "type": "object"
}